{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "vimap",
	"main": "src/worker.js",
	"compatibility_date": "2026-09-10",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vimap-db",
			"database_id": "20dce2dc-e4cd-4be8-861b-537aea33a17d",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		"crons": [
			"0 3 * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}